# ==========================================
# Proveedor de LLM
# ==========================================
# Opciones: ollama | gemini
LLM_PROVIDER=ollama
# Opcional: proveedor secundario para fallback
# Opciones: vacio | ollama | gemini
LLM_FALLBACK_PROVIDER=gemini

# ==========================================
# Configuracion para Ollama (local)
# ==========================================
# Modelo sugerido para Ollama
OLLAMA_MODEL=llama3
# Si corres en Docker Compose con servicio ollama: http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# ==========================================
# Configuracion para Gemini
# ==========================================
# Solo requerido si LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# API y CORS (util en despliegue con proxy)
# ==========================================
# Si expones backend bajo /api en un reverse proxy, usa /api
API_ROOT_PATH=
# Lista separada por coma
CORS_ALLOW_ORIGINS=http://localhost:4200

# ==========================================
# Logging
# ==========================================
LOG_DB_PATH=logs/logs.db
# Recomendado para concurrencia en servidor
SQLITE_JOURNAL_MODE=WAL

# ==========================================
# Embeddings / Vector store
# ==========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=vector_store

# ==========================================
# Chunking
# ==========================================
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ==========================================
# Fuentes de datos
# ==========================================
OBSIDIAN_VAULT_DIR=files/obsidian
OBSIDIAN_ENCODING=utf-8
PDF_DIR=files/pdfs
