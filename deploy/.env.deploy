# Modo local sin DNS
DOMAIN=localhost

# Imagen del frontend local
FRONTEND_IMAGE=chatbot-frontend:local

# Puertos expuestos por el reverse proxy
HTTP_PORT=80
HTTPS_PORT=443

# Conexion hacia Ollama interno (solo si usas profile ollama)
OLLAMA_HOST=http://ollama:11434

# SQLite en volumen persistente
LOG_DB_PATH=/app/logs/logs.db
SQLITE_JOURNAL_MODE=WAL
