# Dominio local en DNS o hosts
DOMAIN=chatbot.lab.local

# Imagen del frontend (repo separado)
# Ejemplo:
# FRONTEND_IMAGE=ghcr.io/tu-org/chatbot-frontend:latest
FRONTEND_IMAGE=nginx:stable-alpine

# Puertos expuestos por el reverse proxy
HTTP_PORT=80
HTTPS_PORT=443

# Conexion hacia Ollama interno (solo si levantas profile ollama)
OLLAMA_HOST=http://ollama:11434

# SQLite en volumen persistente
LOG_DB_PATH=/app/logs/logs.db
SQLITE_JOURNAL_MODE=WAL
